<ContextMenu x:Class="YMusicTaskbar.PlayerMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Placement="MousePoint" HasDropShadow="False" StaysOpen="False" Focusable="True"
             FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource PlayerText}"
             Background="{DynamicResource PlayerSurface}" BorderBrush="{DynamicResource PlayerBorder}" BorderThickness="1"
             MinWidth="294" MaxWidth="340" ToolTipService.IsEnabled="False">
    <ContextMenu.Resources>
<ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/YMusicTaskbar;component/Views/ThemePalette.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="MenuSeparator" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                <Border Height="1" Margin="12,6" Background="{DynamicResource PlayerBorder}" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                <Path x:Name="Check" Visibility="Collapsed" Data="M 1,5 L 4,8 10,1" Stroke="{DynamicResource PlayerAccent}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <Path x:Name="Arrow" Grid.Column="2" Visibility="Collapsed" Data="M 1,1 L 5,5 1,9" Stroke="{DynamicResource PlayerSecondary}" StrokeThickness="1.3" Width="6" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" HorizontalOffset="-2" VerticalOffset="-7" PopupAnimation="None">
                            <Border Background="{DynamicResource PlayerSurface}" BorderBrush="{DynamicResource PlayerBorder}" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="225" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PlayerHover}" /></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PlayerHover}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource PlayerSecondary}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </ResourceDictionary></ContextMenu.Resources>
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="6" SnapsToDevicePixels="True">
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </ScrollViewer>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
</ContextMenu>
