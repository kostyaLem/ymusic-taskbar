<Window x:Class="YMusicTaskbar.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Настройки — YMusic Taskbar" Width="700" Height="740" MinWidth="520" MinHeight="440" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Icon="/YMusicTaskbar;component/Assets/app.ico"
 Background="{DynamicResource PlayerSurface}" Foreground="{DynamicResource PlayerText}" FontFamily="Segoe UI" FontSize="13" ToolTipService.IsEnabled="False">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/YMusicTaskbar;component/Views/SettingsStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Настройки" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="YMusic Taskbar" Foreground="{DynamicResource PlayerSecondary}" Margin="0,4,0,18"/></StackPanel>
  <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Тема"/><ComboBox x:Name="ThemeChoice" AutomationProperties.Name="Тема"><ComboBoxItem Content="Как панель задач Windows"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Тёмная"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Предпочтительный экран"/><ComboBox x:Name="PreferredChoice" AutomationProperties.Name="Предпочтительный экран"/></StackPanel>
   </Grid>
   <CheckBox x:Name="StartupChoice" Content="Запускать вместе с Windows"/>
   <TextBlock Text="Поведение на экранах" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,5"/>
   <TextBlock Text="Выбери монитор — ниже появятся его настройки." Foreground="{DynamicResource PlayerSecondary}" Margin="0,0,0,12"/>
   <ListBox x:Name="MonitorSelector" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,12" SelectionChanged="SelectMonitor" ItemContainerStyle="{StaticResource MonitorTile}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Экраны">
    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <Path Data="M 2,2 L 42,2 42,27 2,27 Z M 22,27 L 22,34 M 12,34 L 32,34" Width="44" Height="36" Stroke="{DynamicResource PlayerText}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource PlayerSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border x:Name="ProfileEditor" BorderBrush="{DynamicResource PlayerBorder}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,14">
    <StackPanel><CheckBox x:Name="EnabledChoice" Content="Показывать плеер на этом экране" Checked="ProfileChanged" Unchecked="ProfileChanged"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Выравнивание" Foreground="{DynamicResource PlayerSecondary}"/><ComboBox x:Name="SideChoice" Margin="0,6,0,0" SelectionChanged="ProfileChanged"><ComboBoxItem Content="К левому краю"/><ComboBoxItem Content="К правому краю"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Вид плеера" Foreground="{DynamicResource PlayerSecondary}"/><ComboBox x:Name="LayoutChoice" Margin="0,6,0,0" SelectionChanged="ProfileChanged"><ComboBoxItem Content="Полный — с перемоткой"/><ComboBoxItem Content="Компактный"/></ComboBox></StackPanel>
     </Grid>
     <TextBlock Text="Плеер прижимается к выбранному краю свободного места на панели задач, не перекрывая кнопки приложений." Foreground="{DynamicResource PlayerSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
   <TextBlock Text="Если места нет или экран занят полноэкранным приложением, плеер перейдёт на другой разрешённый экран." Foreground="{DynamicResource PlayerSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <TextBlock Text="Диагностика" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <Button x:Name="DiagnosticsButton" Content="Сохранить диагностику" HorizontalAlignment="Left" Click="SaveDiagnostics" Margin="0,0,0,6"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource PlayerAccent}" TextWrapping="Wrap" Margin="0,0,230,0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" Click="Cancel" Margin="0,0,10,0"/><Button Content="Сохранить" IsDefault="True" Click="Save"/></StackPanel></Grid>
 </Grid>
</Window>